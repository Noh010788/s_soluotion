<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">rental_product_maintenance.product_template_form_view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <div class="oe_button_box" position="inside">
                <button name="action_view_maintenance"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-wrench"
                    string="Maintenance"
                    invisible="not is_rental"/>
            </div>
        </field>
    </record>

    <record id="product_template_form_preventive_maintenance_view" model="ir.ui.view">
        <field name="name">rental_product_maintenance.product_template_form_preventive_maintenance_view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="rental_product_base.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="deposit_amount" position="after">
                <field name="rental_preventive_maintenance"/>
                <field name="rental_preventive_maintenance_days"
                       invisible="not rental_preventive_maintenance"/>
            </field>
        </field>
    </record>
</odoo>
