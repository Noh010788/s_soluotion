<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_invoice_description" model="ir.ui.view">
        <field name="name">account.move.form.invoice.description</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="attributes">
                <attribute name="widget">many2one</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                <field name="invoice_description" string="Description" widget="text" optional="show" width="280px"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']" position="attributes">
                <attribute name="string">Description</attribute>
                <attribute name="optional">show</attribute>
                <attribute name="column_invisible">False</attribute>
                <attribute name="width">280px</attribute>
                <attribute name="widget"/>
            </xpath>
        </field>
    </record>
</odoo>
