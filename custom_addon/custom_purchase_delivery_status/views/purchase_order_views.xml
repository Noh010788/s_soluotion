<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_list_delivery_status" model="ir.ui.view">
        <field name="name">purchase.order.list.delivery.status</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase_stock.purchase_order_view_tree_inherit"/>
        <field name="arch" type="xml">
            <field name="receipt_status" position="replace">
                <field name="receipt_status"
                       string="Delivery Status"
                       widget="badge"
                       decoration-success="receipt_status == 'full'"
                       decoration-warning="receipt_status == 'partial'"
                       decoration-muted="receipt_status == 'pending'"/>
            </field>
        </field>
    </record>

    <record id="purchase_order_dashboard_list_delivery_status" model="ir.ui.view">
        <field name="name">purchase.order.dashboard.list.delivery.status</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="receipt_status"
                       string="Delivery Status"
                       widget="badge"
                       decoration-success="receipt_status == 'full'"
                       decoration-warning="receipt_status == 'partial'"
                       decoration-muted="receipt_status == 'pending'"/>
            </field>
        </field>
    </record>

    <record id="purchase_order_basic_list_delivery_status" model="ir.ui.view">
        <field name="name">purchase.order.basic.list.delivery.status</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="receipt_status"
                       string="Delivery Status"
                       widget="badge"
                       decoration-success="receipt_status == 'full'"
                       decoration-warning="receipt_status == 'partial'"
                       decoration-muted="receipt_status == 'pending'"/>
            </field>
        </field>
    </record>

    <record id="purchase_order_form_delivery_status" model="ir.ui.view">
        <field name="name">purchase.order.form.delivery.status</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="after">
                <field name="receipt_status"
                       string="Delivery Status"
                       invisible="state not in ('purchase', 'done')"
                       widget="badge"
                       decoration-success="receipt_status == 'full'"
                       decoration-warning="receipt_status == 'partial'"
                       decoration-muted="receipt_status == 'pending'"/>
            </xpath>
        </field>
    </record>
</odoo>
