<odoo>
 <record id="invoice_form" model="ir.ui.view"><field name="name">Invoice rental billing</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_rental_billing" type="object" string="Print Rental Billing" groups="account.group_account_invoice" invisible="move_type != 'out_invoice' or state != 'posted'"/></xpath></field></record>
 <record id="statement_list" model="ir.ui.view"><field name="name">Rental billing list</field><field name="model">rental.billing.statement</field><field name="arch" type="xml"><list><field name="name"/><field name="invoice_id"/><field name="first_month"/><field name="months"/><field name="period_start"/><field name="period_end"/><field name="due_date"/><field name="currency_id" column_invisible="True"/><field name="amount_total"/><field name="amount_due"/><field name="settlement_status"/><field name="state"/></list></field></record>
 <record id="statement_form" model="ir.ui.view"><field name="name">Rental billing form</field><field name="model">rental.billing.statement</field><field name="arch" type="xml"><form string="Rental Billing Statement"><header><button name="action_issue" type="object" string="Issue and Print" class="btn-primary" invisible="state != 'draft'"/><button name="action_print" type="object" string="Print Again" invisible="state != 'issued'"/><button name="action_cancel" type="object" string="Cancel Statement" confirm="Cancel this statement and release its installments for rebilling?" invisible="state == 'cancel'"/><field name="state" widget="statusbar"/></header><sheet><h1><field name="name"/></h1><group><group><field name="invoice_id" readonly="state != 'draft'" domain="[('move_type','=','out_invoice'),('state','=','posted')]"/><field name="company_id"/><field name="partner_id"/><field name="first_month" readonly="state != 'draft'"/><field name="months" readonly="state != 'draft'"/></group><group><field name="date" readonly="state != 'draft'"/><field name="due_date" readonly="state != 'draft'"/><field name="period_start"/><field name="period_end"/><field name="currency_id"/></group></group><div class="alert alert-info">Installments follow the contract start day, not calendar months. This statement does not create a new invoice or change the original due date. Settlement is allocated to issued installments earliest first and includes payments, credits and write-offs; it is not a payment receipt.</div><field name="line_ids"><list create="0" edit="0" delete="0"><field name="name"/><field name="quantity"/><field name="discount"/><field name="tax_names"/><field name="subtotal"/></list></field><group><field name="amount_untaxed"/><field name="amount_tax"/><field name="amount_total"/><field name="settled_amount"/><field name="amount_due"/><field name="settlement_status"/></group></sheet></form></field></record>
</odoo>
