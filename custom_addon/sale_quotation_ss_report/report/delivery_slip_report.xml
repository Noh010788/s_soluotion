<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock.action_report_delivery" model="ir.actions.report">
        <field name="name">ໃບສົ່ງມອບສິນຄ້າ/Delivery Slip</field>
        <field name="paperformat_id" ref="sale_quotation_ss_report.paperformat_ss_sale_quotation"/>
    </record>

    <template id="report_delivery_document_ss" inherit_id="stock.report_delivery_document" priority="99">
        <xpath expr="//t[@t-call='web.html_container']" position="replace">
            <t t-call="web.html_container">
                <t t-set="o" t-value="o.with_context(lang=o._get_report_lang())"/>
                <t t-set="partner" t-value="o.partner_id or (o.move_ids and o.move_ids[0].partner_id) or False"/>
                <t t-set="delivery_date" t-value="o.date_done if o.state == 'done' else o.scheduled_date"/>
                <t t-set="moves" t-value="o.move_ids.filtered(lambda move: move.product_uom_qty)"/>
                <t t-call="web.basic_layout">
                    <div class="page ss_delivery_page">
                        <style>
                            @font-face {
                                font-family: "Phetsarath";
                                src: url("/sale_quotation_ss_report/static/src/fonts/Phetsarath_OT.ttf") format("truetype");
                                font-weight: 400;
                                font-style: normal;
                            }
                            @font-face {
                                font-family: "Phetsarath";
                                src: url("/sale_quotation_ss_report/static/src/fonts/Phetsarath_OT_Bold.ttf") format("truetype");
                                font-weight: 700;
                                font-style: normal;
                            }
                            .ss_delivery_page,
                            .ss_delivery_page * {
                                font-family: "Phetsarath" !important;
                            }
                            .ss_delivery_page {
                                color: #000;
                                font-size: 13px;
                                padding: 0;
                            }
                            .ss_delivery_header,
                            .ss_delivery_footer {
                                width: 100%;
                                height: auto;
                            }
                            .ss_delivery_header { margin-bottom: 12px; }
                            .ss_delivery_footer { margin-top: 10px; }
                            .ss_delivery_title {
                                text-align: center;
                                font-size: 18px;
                                font-weight: 700;
                                margin: 0 0 12px;
                            }
                            .ss_delivery_info {
                                width: 100%;
                                border-collapse: collapse;
                                margin-bottom: 18px;
                            }
                            .ss_delivery_info td {
                                border: 0;
                                padding: 3px 6px;
                                vertical-align: top;
                            }
                            .ss_delivery_info .ss_label {
                                font-weight: 700;
                                white-space: nowrap;
                            }
                            .ss_delivery_table {
                                width: 100%;
                                border-collapse: collapse;
                                table-layout: fixed;
                            }
                            .ss_delivery_table th,
                            .ss_delivery_table td {
                                border: 1px solid #000;
                                padding: 5px 7px;
                                vertical-align: middle;
                            }
                            .ss_delivery_table th {
                                text-align: center;
                                font-weight: 700;
                            }
                            .ss_delivery_line { height: 190px; }
                            .ss_delivery_center { text-align: center; }
                            .ss_delivery_product_image {
                                max-width: 125px;
                                max-height: 115px;
                                object-fit: contain;
                            }
                            .ss_delivery_note { height: 45px; vertical-align: top !important; }
                            .ss_delivery_ack {
                                text-align: center;
                                font-weight: 700;
                                margin: 30px 10px 18px;
                            }
                            .ss_delivery_signatures {
                                width: 100%;
                                border-collapse: collapse;
                                border: 0 !important;
                            }
                            .ss_delivery_signatures tr {
                                border: 0 !important;
                            }
                            .ss_delivery_signatures td {
                                width: 50%;
                                height: 135px;
                                border: 0 !important;
                                text-align: center;
                                vertical-align: top;
                                font-weight: 700;
                                padding-top: 8px;
                            }
                        </style>

                        <img src="/sale_quotation_ss_report/static/src/img/header.jpg" class="ss_delivery_header"/>

                        <h2 class="ss_delivery_title">ໃບສົ່ງມອບສິນຄ້າ/Delivery Slip</h2>

                        <table class="ss_delivery_info">
                            <colgroup>
                                <col style="width: 13%;"/>
                                <col style="width: 57%;"/>
                                <col style="width: 10%;"/>
                                <col style="width: 20%;"/>
                            </colgroup>
                            <tbody>
                                <tr>
                                    <td class="ss_label">Customer:</td>
                                    <td><span t-if="partner" t-field="partner.name"/></td>
                                    <td class="ss_label">No:</td>
                                    <td><span t-field="o.name"/></td>
                                </tr>
                                <tr>
                                    <td class="ss_label">Address:</td>
                                    <td>
                                        <span t-if="partner"
                                              t-out="', '.join([part for part in [partner.street, partner.street2, partner.city, partner.state_id.name if partner.state_id else False, partner.country_id.name if partner.country_id else False] if part])"/>
                                    </td>
                                    <td class="ss_label">Date:</td>
                                    <td><span t-if="delivery_date" t-out="delivery_date.strftime('%d/%m/%Y')"/></td>
                                </tr>
                                <tr>
                                    <td class="ss_label">Tel:</td>
                                    <td>
                                        <span t-if="partner and partner.phone" t-field="partner.phone"/>
                                        <span t-elif="partner and partner.mobile" t-field="partner.mobile"/>
                                        <span t-else="">------------------------------</span>
                                    </td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>

                        <table class="ss_delivery_table">
                            <colgroup>
                                <col style="width: 10%;"/>
                                <col style="width: 25%;"/>
                                <col style="width: 20%;"/>
                                <col style="width: 25%;"/>
                                <col style="width: 20%;"/>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>ລຳດັບ<br/>No.</th>
                                    <th>ຊື່<br/>Name</th>
                                    <th>ປະເພດສິນຄ້າ<br/>Product Type</th>
                                    <th>ຮູບພາບສິນຄ້າ<br/>Product Image</th>
                                    <th>ຈຳນວນ<br/>Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="line_number" t-value="0"/>
                                <t t-foreach="moves" t-as="move">
                                    <t t-set="line_number" t-value="line_number + 1"/>
                                    <tr class="ss_delivery_line">
                                        <td class="ss_delivery_center"><span t-out="line_number"/></td>
                                        <td class="ss_delivery_center"><span t-field="move.product_id.name"/></td>
                                        <td class="ss_delivery_center"><span t-field="move.product_id.categ_id.name"/></td>
                                        <td class="ss_delivery_center">
                                            <img t-if="move.product_id.image_1920"
                                                 t-att-src="image_data_uri(move.product_id.image_1920)"
                                                 class="ss_delivery_product_image"/>
                                        </td>
                                        <td class="ss_delivery_center">
                                            <span t-field="move.quantity" t-options='{"widget": "float", "precision": 0}' t-if="o.state == 'done'"/>
                                            <span t-field="move.product_uom_qty" t-options='{"widget": "float", "precision": 0}' t-else=""/>
                                        </td>
                                    </tr>
                                </t>
                                <tr>
                                    <td colspan="3">
                                        ເລກທີ່ເຄື່ອງ:
                                        <span t-out="', '.join(o.move_line_ids.mapped('lot_id.name'))"/>
                                    </td>
                                    <td class="ss_delivery_center" style="font-weight: 700;">ຈຳນວນລວມ</td>
                                    <td class="ss_delivery_center" style="font-weight: 700;">
                                        <span t-out="sum(moves.mapped('quantity')) if o.state == 'done' else sum(moves.mapped('product_uom_qty'))"
                                              t-options='{"widget": "float", "precision": 0}'/>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="5" class="ss_delivery_note">
                                        ໝາຍເຫດ:
                                        <span t-if="o.note" t-field="o.note"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="ss_delivery_ack">
                            ເອກະສານສະບັບນີ້ ສຳລັບຢືນຢັນການສົ່ງມອບ-ຮັບສິນຄ້າຖືກຕ້ອງ
                            ແລະ ຄົບຖ້ວນຕາມຈຳນວນ
                        </div>

                        <table class="ss_delivery_signatures">
                            <tr>
                                <td>ຜູ້ຮັບສິນຄ້າ</td>
                                <td>ຜູ້ສົ່ງມອບສິນຄ້າ</td>
                            </tr>
                        </table>

                        <img src="/sale_quotation_ss_report/static/src/img/footer.jpg" class="ss_delivery_footer"/>
                    </div>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
