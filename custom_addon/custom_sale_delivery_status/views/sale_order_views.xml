<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_quotation_with_delivery_status_list" model="ir.ui.view">
        <field name="name">sale.order.list.delivery.status</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_status']" position="after">
                <field name="delivery_status"
                       string="Delivery Status"
                       decoration-success="delivery_status == 'full'"
                       decoration-warning="delivery_status == 'partial'"
                       decoration-muted="delivery_status == 'pending'"
                       widget="badge"/>
            </xpath>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_quotation_with_delivery_status_form" model="ir.ui.view">
        <field name="name">sale.order.form.delivery.status</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Place after state field in the header statusbar -->
            <xpath expr="//header/field[@name='state']" position="after">
                <field name="delivery_status"
                       string="Delivery Status"
                       widget="badge"
                       decoration-success="delivery_status == 'full'"
                       decoration-warning="delivery_status == 'partial'"
                       decoration-muted="delivery_status == 'pending'"/>
            </xpath>
        </field>
    </record>
</odoo>
