<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account.account_invoices" model="ir.actions.report">
        <field name="paperformat_id" ref="sale_quotation_ss_report.paperformat_ss_sale_quotation"/>
    </record>
    <record id="account.account_invoices_without_payment" model="ir.actions.report">
        <field name="paperformat_id" ref="sale_quotation_ss_report.paperformat_ss_sale_quotation"/>
    </record>

    <template id="report_invoice_document_ss" inherit_id="account.report_invoice_document" priority="99">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <t t-set="product_lines" t-value="o.invoice_line_ids.filtered(lambda line: line.display_type == 'product')"/>
            <t t-set="note_lines" t-value="o.invoice_line_ids.filtered(lambda line: line.display_type == 'line_note')"/>
            <t t-call="web.basic_layout">
                <div class="ss_invoice_page">
                    <style>
                        @font-face {
                            font-family: "Phetsarath OT";
                            src: url("/sale_quotation_ss_report/static/src/fonts/Phetsarath_OT.ttf") format("truetype");
                            font-weight: 400;
                            font-style: normal;
                        }
                        @font-face {
                            font-family: "Phetsarath OT";
                            src: url("/sale_quotation_ss_report/static/src/fonts/Phetsarath_OT_Bold.ttf") format("truetype");
                            font-weight: 700;
                            font-style: normal;
                        }
                        .ss_invoice_page,
                        .ss_invoice_page * {
                            font-family: "Phetsarath OT" !important;
                        }
                        html,
                        body,
                        main,
                        .o_body_html,
                        .container {
                            height: auto !important;
                            min-height: 0 !important;
                            max-height: none !important;
                            overflow: visible !important;
                        }
                        .ss_invoice_page {
                            font-size: 13px;
                            color: #000;
                            padding: 0;
                            height: auto !important;
                            min-height: 0 !important;
                            overflow: visible !important;
                        }
                        @page {
                            size: A4 portrait;
                            margin: 43mm 8mm 31mm 8mm;
                        }
                        .ss_report_header {
                            position: fixed;
                            top: -38mm;
                            left: 0;
                            right: 0;
                            width: 100%;
                        }
                        .ss_report_footer {
                            position: fixed;
                            bottom: -27mm;
                            left: 0;
                            right: 0;
                            width: 100%;
                        }
                        .ss_invoice_header,
                        .ss_invoice_footer {
                            width: 100%;
                            height: auto;
                        }
                        .ss_invoice_header { margin: 0; }
                        .ss_invoice_footer {
                            object-fit: contain;
                            margin: 0;
                        }
                        .ss_invoice_title {
                            text-align: center;
                            font-size: 18px;
                            font-weight: 700;
                            margin: 0 0 8px;
                        }
                        table.ss_invoice_table {
                            width: 100%;
                            border-collapse: collapse;
                            table-layout: fixed;
                            page-break-inside: auto;
                            break-inside: auto;
                        }
                        .ss_invoice_table tr {
                            page-break-inside: auto;
                            break-inside: auto;
                            page-break-after: auto;
                        }
                        .ss_product_row {
                            page-break-inside: avoid;
                            break-inside: avoid;
                        }
                        .ss_summary_row,
                        .ss_bank_row,
                        .ss_signature_row {
                            page-break-inside: avoid;
                            break-inside: avoid;
                        }
                        .ss_invoice_table td,
                        .ss_invoice_table th {
                            border: 1px solid #000;
                            padding: 4px 7px;
                            vertical-align: top;
                        }
                        .ss_invoice_table th {
                            text-align: center;
                            font-weight: 400;
                        }
                        .ss_invoice_center { text-align: center; }
                        .ss_invoice_right { text-align: right; }
                        .ss_invoice_bold { font-weight: 700; }
                        .ss_invoice_partner_box { min-height: 36px; }
                        .ss_invoice_info_row td {
                            border: 0 !important;
                            padding: 2px 4px;
                            vertical-align: top;
                        }
                        .ss_invoice_line {
                            text-align: left;
                            line-height: 1.45;
                            min-height: 170px;
                            padding: 8px 4px;
                            box-sizing: border-box;
                        }
                        .ss_invoice_product_img {
                            max-width: 90px;
                            max-height: 90px;
                            margin-top: 8px;
                            object-fit: contain;
                        }
                        .ss_invoice_summary_label {
                            text-align: center;
                            font-weight: 700;
                        }
                        .ss_invoice_amount {
                            text-align: right;
                            white-space: nowrap;
                        }
                        .ss_invoice_note {
                            min-height: 62px;
                            height: 62px;
                        }
                        .ss_invoice_signature {
                            height: 178px;
                            text-align: center;
                        }
                        table.ss_signature_split {
                            width: 100%;
                            border-collapse: collapse;
                            table-layout: fixed;
                        }
                        .ss_signature_split td {
                            border: 0;
                            height: 178px;
                            padding: 4px 7px;
                            text-align: center;
                            vertical-align: top;
                        }
                        .ss_summary_page {
                            margin-top: 8px;
                        }
                        .ss_summary_page_break {
                            page-break-before: always;
                            break-before: page;
                        }
                    </style>

                    <div class="ss_report_header">
                        <img src="/sale_quotation_ss_report/static/src/img/header.jpg" class="ss_invoice_header"/>
                    </div>
                    <div class="ss_report_footer">
                        <img src="/sale_quotation_ss_report/static/src/img/footer.jpg" class="ss_invoice_footer"/>
                    </div>

                    <t t-set="show_discount" t-value="product_lines.filtered(lambda discount_line: discount_line.discount)"/>

                    <h2 class="ss_invoice_title">ໃບເກັບເງິນ/INVOICE</h2>

                    <table class="ss_invoice_table">
                        <colgroup>
                            <col t-if="not show_discount" style="width: 7%;"/>
                            <col t-if="not show_discount" style="width: 40%;"/>
                            <col t-if="not show_discount" style="width: 9%;"/>
                            <col t-if="not show_discount" style="width: 19%;"/>
                            <col t-if="not show_discount" style="width: 21%;"/>
                            <col t-if="show_discount" style="width: 7%;"/>
                            <col t-if="show_discount" style="width: 35%;"/>
                            <col t-if="show_discount" style="width: 8%;"/>
                            <col t-if="show_discount" style="width: 17%;"/>
                            <col t-if="show_discount" style="width: 13%;"/>
                            <col t-if="show_discount" style="width: 20%;"/>
                        </colgroup>
                        <tbody>
                            <tr class="ss_invoice_info_row">
                                <td colspan="2" rowspan="3" style="vertical-align: top; text-align: left;">
                                    <div>
                                        Customer: <span t-field="o.partner_id.name"/>
                                    </div>
                                    <div>
                                        Address:
                                        <span t-out="', '.join([part for part in [o.partner_id.street, o.partner_id.street2, o.partner_id.city, o.partner_id.state_id.name if o.partner_id.state_id else False, o.partner_id.country_id.name if o.partner_id.country_id else False] if part])"/>
                                    </div>
                                    <div>
                                        Tel:
                                        <span t-if="o.partner_id.phone" t-field="o.partner_id.phone"/>
                                        <span t-elif="o.partner_id.mobile" t-field="o.partner_id.mobile"/>
                                    </div>
                                </td>
                                <td t-att-colspan="4 if show_discount else 3" class="ss_invoice_right" style="text-align: right; padding-right: 38px;">
                                    ເລກທີ: <span t-field="o.name"/>
                                </td>
                            </tr>
                            <tr class="ss_invoice_info_row">
                                <td t-att-colspan="4 if show_discount else 3" class="ss_invoice_right" style="text-align: right; padding-right: 38px;">
                                    ວັນທີ:
                                    <span t-if="o.invoice_date" t-field="o.invoice_date" t-options='{"widget": "date", "format": "dd / MM / yyyy"}'/>
                                </td>
                            </tr>
                            <tr class="ss_invoice_info_row">
                                <td t-att-colspan="4 if show_discount else 3" class="ss_invoice_partner_box">
                                </td>
                            </tr>
                            <tr class="ss_invoice_info_row">
                                <th>Item</th>
                                <th>Description</th>
                                <th>Quantity<br/>(Units)</th>
                                <th>Unit price<br/>LAK</th>
                                <th t-if="show_discount">Discount</th>
                                <th>Amount<br/>LAK</th>
                            </tr>

                            <t t-set="line_number" t-value="0"/>
                            <t t-foreach="product_lines" t-as="line">
                                <t t-set="line_number" t-value="line_number + 1"/>
                                <tr class="ss_product_row" t-att-style="'page-break-before: always; break-before: page;' if line_number > 1 and (line_number - 1) % 4 == 0 else ''">
                                    <td class="ss_invoice_center" style="vertical-align: middle;">
                                        <span t-out="line_number"/>
                                    </td>
                                    <td>
                                        <div class="ss_invoice_line">
                                            <div t-field="line.name" style="white-space: pre-line;"/>
                                            <t t-set="serial_numbers" t-value="', '.join(line.sale_line_ids.mapped('move_ids.move_line_ids.lot_id.name'))"/>
                                            <div t-if="line.product_id.product_tmpl_id.warranty_period_months">
                                                Warranty: <span t-out="line.product_id.product_tmpl_id.warranty_period_months"/> months
                                            </div>
                                            <div t-if="serial_numbers">Serial Number: <span t-out="serial_numbers"/></div>
                                        </div>
                                    </td>
                                    <td class="ss_invoice_center" style="vertical-align: middle;">
                                        <span t-field="line.quantity" t-options='{"widget": "float", "precision": 0}'/>
                                        <span t-field="line.product_uom_id"/>
                                    </td>
                                    <td class="ss_invoice_amount" style="vertical-align: middle;">
                                        <span t-out="'{:,.0f} {}'.format(line.price_unit, o.currency_id.symbol or '').strip()"/>
                                    </td>
                                    <td t-if="show_discount" class="ss_invoice_amount" style="vertical-align: middle;">
                                        <t t-if="line.discount">
                                            <div>
                                                <span t-out="'{:g}'.format(line.discount)"/>%
                                            </div>
                                            <div>
                                                <span t-out="'{:,.0f} {}'.format(line.price_unit * line.quantity * line.discount / 100.0, o.currency_id.symbol or '').strip()"/>
                                            </div>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>
                                    <td class="ss_invoice_amount" style="vertical-align: middle;">
                                        <span t-out="'{:,.0f} {}'.format(line.price_subtotal, o.currency_id.symbol or '').strip()"/>
                                    </td>
                                </tr>
                            </t>

                            <tr class="ss_summary_row" t-att-style="'page-break-before: always; break-before: page;' if line_number and line_number % 4 == 0 else ''">
                                <td colspan="2" rowspan="3" class="ss_invoice_note">
                                    <div style="text-align: center;">Remark:</div>
                                    <t t-foreach="note_lines" t-as="note_line">
                                        <div style="white-space: pre-line;" t-field="note_line.name"/>
                                    </t>
                                </td>
                                <td t-att-colspan="3 if show_discount else 2" class="ss_invoice_summary_label">ລວມເງິນ/Total</td>
                                <td class="ss_invoice_amount">
                                    <span t-out="'{:,.0f} {}'.format(o.amount_untaxed, o.currency_id.symbol or '').strip()"/>
                                </td>
                            </tr>
                            <tr class="ss_summary_row">
                                <td t-att-colspan="3 if show_discount else 2" class="ss_invoice_summary_label">VAT 10%</td>
                                <td class="ss_invoice_amount">
                                    <span t-out="'{:,.0f} {}'.format(o.amount_tax, o.currency_id.symbol or '').strip()"/>
                                </td>
                            </tr>
                            <tr class="ss_summary_row">
                                <td t-att-colspan="3 if show_discount else 2" class="ss_invoice_summary_label">ລວມທັງໝົດ/Total Amount</td>
                                <td class="ss_invoice_amount ss_invoice_bold">
                                    <span t-out="'{:,.0f} {}'.format(o.amount_total, o.currency_id.symbol or '').strip()"/>
                                </td>
                            </tr>

                            <tr class="ss_signature_row">
                                <td t-att-colspan="6 if show_discount else 5"
                                    style="border: 0 !important; height: 220px; padding: 0 70px 10px 0; text-align: right; vertical-align: bottom;">
                                    Director
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </div>
            </t>

        </xpath>
    </template>
</odoo>
