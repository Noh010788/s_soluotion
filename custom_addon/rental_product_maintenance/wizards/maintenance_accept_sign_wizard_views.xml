<odoo>
    <record id="maintenance_accept_sign_wizard_view_form" model="ir.ui.view">
        <field name="name">rental.maintenance.accept.sign.wizard.form</field>
        <field name="model">rental.maintenance.accept.sign.wizard</field>
        <field name="arch" type="xml">
            <form string="Accept &amp; Sign">
                <group>
                    <field name="request_id"/>
                    <field name="target_stage_id" invisible="1"/>
                    <field name="customer_name"/>
                    <field name="signature" widget="signature" full_name="customer_name"/>
                </group>
                <footer>
                    <button name="action_accept_and_done" type="object" string="Accept &amp; Done" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
